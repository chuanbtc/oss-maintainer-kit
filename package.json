{
  "name": "oss-maintainer-kit",
  "version": "0.1.0",
  "description": "A CLI toolkit for open source maintainers to draft issue triage, PR reviews, release notes, and weekly reports.",
  "type": "module",
  "bin": {
    "omk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "open-source",
    "maintainers",
    "github",
    "cli",
    "triage",
    "release-notes"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
